# Rust build artifacts
/target/
**/*.rs.bk

# Node / frontend build artifacts (ui/dashboard is Svelte + Vite)
node_modules/
dist/

# Cargo lock — keep for binaries, ignore for libraries
# (We keep Cargo.lock since this is a workspace with binaries)

# substrate runtime data directories
.substrate/
~/.substrate/

# Model weight files — large binary blobs, not committed
*.gguf
*.ggml
*.bin.partial

# KV cache blobs
*.kvcache
kvcache/

# SQLite databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Config files with secrets (keep examples, ignore actuals)
substrate.toml
mesh.toml

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment files
.env
.env.local
.env.*.local

# Secrets / credentials
*.key
*.pem
credentials.json
credentials/
secrets/
*.secret

# Test artifacts
/tests/fixtures/large/

# Profiling
*.profraw
perf.data

# Runtime logs (generated by running services, not source)
logs/
*.log
